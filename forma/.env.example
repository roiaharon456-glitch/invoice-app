# Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# Gemini, for voice-note transcription (aistudio.google.com)
GEMINI_API_KEY=

# Supabase (Project Settings -> API). Leave empty to use a local SQLite file.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=any-random-string
WA_TEMPLATE=forma_update
WA_TEMPLATE_LANG=he
# Your own number, digits only with country code, e.g. 972501234567
OWNER_PHONE=

# Web app
PUBLIC_URL=https://forma.onrender.com
SESSION_SECRET=long-random-string
CRON_SECRET=another-random-string

# Local development only: skip login
# DEV_NO_AUTH=1
